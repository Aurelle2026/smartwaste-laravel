# ============================================================
# Config du STACK Docker (docker-compose)
# ============================================================
# Port HTTP exposé sur le VPS (accessible sur http://37.187.195.28:PORT)
HTTP_PORT=8090

# Port PostgreSQL exposé sur 127.0.0.1 uniquement (accès via tunnel SSH)
DB_HOST_PORT=5435

# ============================================================
# Variables Laravel (.env de l'app à l'intérieur des conteneurs)
# ============================================================
APP_NAME=SmartWaste
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://37.187.195.28:8090

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ⚠️ DB_HOST doit rester 'db' (nom du service Docker), pas 127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=smartwaste
DB_USERNAME=smartwaste
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@smartwaste.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
